generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RoleUsuario {
  ALUNO
  PROFESSOR
  ADMIN
}

enum NivelAluno {
  INICIANTE
  INTERMEDIARIO
  AVANCADO
}

enum SerieEscolar {
  PRIMEIRO_ANO
  SEGUNDO_ANO
  TERCEIRO_ANO
  NAO_ESTUDA
}

enum TipoEnsinoMedio {
  PUBLICO
  PRIVADO
  MISTO
}

enum PlanoTipo {
  GRATUITO
  APOIO
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum AreaEnem {
  LINGUAGENS
  HUMANAS
  NATUREZA
  MATEMATICA
}

enum StatusSimulado {
  EM_ANDAMENTO
  CONCLUIDO
}

enum ModoSimulado {
  TREINO
  MODALIDADE
  CRONOMETRADO
}

enum PapelMensagemTutor {
  USER
  ASSISTANT
}

/// Conta autenticada (Google OAuth). Índice único em email evita duplicatas no login.
model Usuario {
  id           String      @id @default(uuid()) @db.Uuid
  nome         String      @db.VarChar(120)
  email        String      @unique @db.VarChar(255)
  fotoUrl      String?     @map("foto_url") @db.VarChar(500)
  role         RoleUsuario @default(ALUNO)
  googleSub    String?     @unique @map("google_sub") @db.VarChar(255)
  criadoEm     DateTime    @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime    @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  perfilAluno     PerfilAluno?
  planoAssinatura PlanoAssinatura?
  proficiencias   ProficienciaArea[]
  usoTokensIa     UsoTokenIa[]
  idempotencyKeys IdempotencyKey[]
  refreshTokens   RefreshToken[]
  simulados       Simulado[]
  conversasTutor  ConversaTutor[]
  depoimento      Depoimento?

  @@index([role])
  @@map("usuarios")
}

/// Banco local de questões ENEM (seed via api.enem.dev).
model Questao {
  id                     String   @id @default(uuid()) @db.Uuid
  enemDevId              String   @unique @map("enem_dev_id") @db.VarChar(120)
  ano                    Int
  area                   AreaEnem
  assuntoId              String?  @map("assunto_id") @db.VarChar(80)
  indice                 Int
  disciplina             String   @db.VarChar(80)
  contexto               String   @db.Text
  introducaoAlternativas String?  @map("introducao_alternativas") @db.Text
  alternativas           Json
  gabarito               String   @db.VarChar(1)
  imagemUrl              String?  @map("imagem_url") @db.VarChar(500)
  criadoEm               DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  simuladoQuestoes SimuladoQuestao[]
  respostas        RespostaSimulado[]

  @@index([area, ano])
  @@index([ano])
  @@index([assuntoId])
  @@map("questoes")
}

/// Simulado gerado para um aluno.
model Simulado {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  area            AreaEnem?
  totalQuestoes   Int            @map("total_questoes")
  respondidas     Int            @default(0)
  acertos         Int            @default(0)
  status          StatusSimulado @default(EM_ANDAMENTO)
  modo            ModoSimulado   @default(TREINO)
  revelarGabaritoImediato Boolean @default(true) @map("revelar_gabarito_imediato")
  tempoLimiteSegundos     Int?    @map("tempo_limite_segundos")
  questaoAtualIdx Int            @default(0) @map("questao_atual_idx")
  iniciadoEm      DateTime       @default(now()) @map("iniciado_em") @db.Timestamptz(3)
  finalizadoEm    DateTime?      @map("finalizado_em") @db.Timestamptz(3)

  usuario  Usuario           @relation(fields: [userId], references: [id], onDelete: Cascade)
  questoes SimuladoQuestao[]
  respostas RespostaSimulado[]

  @@index([userId, status])
  @@index([userId, modo, status])
  @@map("simulados")
}

/// Ordem das questões dentro de um simulado.
model SimuladoQuestao {
  id         String @id @default(uuid()) @db.Uuid
  simuladoId String @map("simulado_id") @db.Uuid
  questaoId  String @map("questao_id") @db.Uuid
  ordem      Int

  simulado Simulado @relation(fields: [simuladoId], references: [id], onDelete: Cascade)
  questao  Questao  @relation(fields: [questaoId], references: [id], onDelete: Restrict)

  @@unique([simuladoId, ordem])
  @@unique([simuladoId, questaoId])
  @@map("simulado_questoes")
}

/// Resposta do aluno a uma questão do simulado.
model RespostaSimulado {
  id           String   @id @default(uuid()) @db.Uuid
  simuladoId   String   @map("simulado_id") @db.Uuid
  questaoId    String   @map("questao_id") @db.Uuid
  alternativa  String   @db.VarChar(1)
  correto      Boolean
  respondidoEm DateTime @default(now()) @map("respondido_em") @db.Timestamptz(3)

  simulado Simulado @relation(fields: [simuladoId], references: [id], onDelete: Cascade)
  questao  Questao  @relation(fields: [questaoId], references: [id], onDelete: Restrict)

  @@unique([simuladoId, questaoId])
  @@map("respostas_simulado")
}

/// Refresh tokens opacos — só hash no banco; raw token vai em cookie HttpOnly.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  criadoEm  DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Dados de onboarding e preferências do aluno (1:1 com Usuario).
model PerfilAluno {
  userId             String           @id @map("user_id") @db.Uuid
  cursoObjetivo      String?          @map("curso_objetivo") @db.VarChar(200)
  serieEscolar       SerieEscolar?    @map("serie_escolar")
  tipoEnsinoMedio    TipoEnsinoMedio? @map("tipo_ensino_medio")
  tempoDiarioMinutos Int              @default(120) @map("tempo_diario_minutos")
  nivelAtual         NivelAluno       @default(INICIANTE) @map("nivel_atual")
  trilhaEstado       Json?            @map("trilha_estado") @db.JsonB
  atualizadoEm       DateTime         @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("perfis_aluno")
}

/// Plano freemium / apoio — base para rate limit dinâmico de tokens de IA.
model PlanoAssinatura {
  userId           String    @id @map("user_id") @db.Uuid
  tipo             PlanoTipo @default(GRATUITO)
  tokensDiarios    Int       @default(10) @map("tokens_diarios")
  mercadoPagoSubId String?   @map("mercado_pago_sub_id") @db.VarChar(120)
  ativo            Boolean   @default(true)
  criadoEm         DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm     DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tipo, ativo])
  @@map("planos_assinatura")
}

/// Score pré-calculado por área — leitura rápida no dashboard (evita agregar milhares de respostas).
model ProficienciaArea {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  area          String   @db.VarChar(80)
  score         Decimal  @default(0) @db.Decimal(5, 2)
  totalQuestoes Int      @default(0) @map("total_questoes")
  acertos       Int      @default(0)
  atualizadoEm  DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, area])
  @@index([userId])
  @@map("proficiencias_area")
}

/// Contador diário de consumo de IA — suporta rate limiting por plano.
model UsoTokenIa {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  data         DateTime @db.Date
  consumo      Int      @default(0)
  limite       Int      @default(10)
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, data])
  @@index([userId, data(sort: Desc)])
  @@map("uso_tokens_ia")
}

/// Chaves de idempotência — evita cobrança/processamento duplicado em retries de rede.
model IdempotencyKey {
  id          String            @id @default(uuid()) @db.Uuid
  chave       String            @unique @db.VarChar(255)
  userId      String?           @map("user_id") @db.Uuid
  endpoint    String            @db.VarChar(120)
  requestHash String?           @map("request_hash") @db.VarChar(64)
  status      IdempotencyStatus @default(PROCESSING)
  response    Json?
  httpStatus  Int?              @map("http_status")
  expiresAt   DateTime          @map("expires_at") @db.Timestamptz(3)
  criadoEm    DateTime          @default(now()) @map("criado_em") @db.Timestamptz(3)

  usuario Usuario? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@index([userId, endpoint])
  @@map("idempotency_keys")
}

/// Conversa do tutor IA — persistida no Postgres (substitui sessionStorage).
model ConversaTutor {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  titulo       String   @default("Nova conversa") @db.VarChar(120)
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  usuario   Usuario         @relation(fields: [userId], references: [id], onDelete: Cascade)
  mensagens MensagemTutor[]

  @@index([userId, atualizadoEm(sort: Desc)])
  @@map("conversas_tutor")
}

/// Mensagem de uma conversa do tutor (ordem sequencial).
model MensagemTutor {
  id         String              @id @default(uuid()) @db.Uuid
  conversaId String              @map("conversa_id") @db.Uuid
  papel      PapelMensagemTutor
  texto      String              @db.Text
  anexoUrl   String?             @map("anexo_url") @db.VarChar(500)
  ordem      Int
  criadoEm   DateTime            @default(now()) @map("criado_em") @db.Timestamptz(3)

  conversa ConversaTutor @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  @@unique([conversaId, ordem])
  @@index([conversaId])
  @@map("mensagens_tutor")
}

/// Depoimento público de um aluno (substitui mocks na landing conforme forem enviados).
model Depoimento {
  id           String   @id @default(uuid()) @db.Uuid
  usuarioId    String   @unique @map("usuario_id") @db.Uuid
  texto        String   @db.VarChar(600)
  papel        String?  @db.VarChar(120)
  aprovado     Boolean  @default(true) @map("aprovado")
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([aprovado, criadoEm])
  @@map("depoimentos")
}
