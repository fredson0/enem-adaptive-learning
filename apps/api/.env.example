# Server
PORT=3333

# Database (Railway PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/railway?schema=public"

# JWT Auth
JWT_SECRET="sua_chave_secreta_super_segura"

# Google OAuth
GOOGLE_CLIENT_ID="seu_client_id.apps.googleusercontent.com"

# IA (Google AI Studio — ver docs/ESCOLHA-MODELO-IA.md)
GEMINI_API_KEY="sua_chave_do_google_ai_studio"
GEMINI_MODEL="gemini-2.5-flash"
IA_PROVIDER="gemini"

# Fallback opcional (Groq — ver docs/ESCOLHA-MODELO-IA.md)
# GROQ_API_KEY="sua_chave_groq"
# GROQ_MODEL="llama-3.3-70b-versatile"

# Pagamentos
MERCADOPAGO_ACCESS_TOKEN="seu_token_do_mercado_pago"

# Redis (rate limiting / cache — opcional em dev)
REDIS_URL="redis://localhost:6379"
