# Server
PORT=3333

# Database (Railway PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/railway?schema=public"

# JWT Auth
JWT_SECRET="sua_chave_secreta_super_segura_min_32_chars"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES_DAYS="7"

# CORS (origens do front, separadas por vírgula)
CORS_ORIGIN="http://localhost:3001"

# Segredo compartilhado com o BFF Next.js — obrigatório em produção.
# Rotas login/refresh/logout só emitem tokens com header X-BFF-Secret.
BFF_INTERNAL_SECRET="dev-bff-secret-trocar-em-producao"

# Rate limit global (ms / req)
THROTTLE_TTL_MS="60000"
THROTTLE_LIMIT="100"

# Dev: remove limite diário de mensagens IA (true = ilimitado para todos)
IA_TOKENS_UNLIMITED="true"

# Google OAuth
GOOGLE_CLIENT_ID="seu_client_id.apps.googleusercontent.com"

# IA — NVIDIA é o provedor principal. Gemini só entra se NVIDIA e Groq falharem.
GEMINI_API_KEY="sua_chave_do_google_ai_studio"
GEMINI_MODEL="gemini-2.5-flash"
IA_PROVIDER="nvidia"

# NVIDIA NIM (build.nvidia.com) — free tier ~40 req/min
NVIDIA_API_KEY="cole_sua_chave_aqui"
NVIDIA_MODEL="openai/gpt-oss-20b"
NVIDIA_MODEL_EXATAS="openai/gpt-oss-120b"
NVIDIA_VISION_MODEL="meta/llama-3.2-11b-vision-instruct"

# Groq (console.groq.com) — fallback vision + exatas (70B recomendado)
# GROQ_API_KEY="sua_chave_groq"
# GROQ_MODEL="llama-3.3-70b-versatile"
# GROQ_MODEL_EXATAS="llama-3.3-70b-versatile"
# GROQ_VISION_MODEL="llama-3.2-11b-vision-preview"

# Gemini — último caso de todos; não faz parte da cadeia principal
# GEMINI_MODEL_EXATAS="gemini-2.5-flash"

# Pagamentos
MERCADOPAGO_ACCESS_TOKEN="seu_token_do_mercado_pago"

# Redis (rate limiting / cache — opcional em dev)
REDIS_URL="redis://localhost:6379"

# Object storage — dev local (produção: STORAGE_PROVIDER=s3 + Railway Bucket)
STORAGE_PROVIDER="local"
LOCAL_UPLOAD_DIR="./.uploads"
LOCAL_UPLOAD_BASE_URL="http://localhost:3001/api/backend/dev-uploads"
API_PUBLIC_URL="http://localhost:3333"

# Produção (Railway Bucket ou R2 — S3-compatible)
# STORAGE_PROVIDER="s3"
# S3_ENDPOINT="https://..."
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# S3_BUCKET_NAME="enem-tutor-anexos"
# S3_REGION="auto"
# S3_PUBLIC_BASE_URL="https://..."
# S3_PRESIGN_EXPIRES_SEC=300
